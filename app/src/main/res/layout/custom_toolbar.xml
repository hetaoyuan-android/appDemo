<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentInsetStartWithNavigation="0dp"
       >


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_left"
        android:layout_width="@dimen/dimen_25dp"
        android:layout_height="@dimen/dimen_25dp"
        android:layout_gravity="left"
        android:src="@drawable/skin_toolbar_left"
        android:visibility="gone"
        android:gravity="center"/>

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:textStyle="bold"
            android:textColor="@color/skin_text_page_title_color"
            android:textSize="@dimen/sp_17"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgv_toolbar"
        android:layout_width="@dimen/dimen_28dp"
        android:layout_height="@dimen/dimen_28dp"
        android:layout_gravity="right"
        android:visibility="gone"
        android:layout_marginEnd="@dimen/dimen_24dp"
        android:gravity="center"/>

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_toolbar_title_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="@dimen/dimen_10dp"
            android:layout_gravity="right"
            android:gravity="center"
            android:text=""
            android:textColor="@color/skin_text_item_title_color"
            android:textSize="@dimen/sp_16"/>

</androidx.appcompat.widget.Toolbar>